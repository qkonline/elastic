{
  "name": "Elastic",
  "short_name": "Elastic",
  "description": "Plan the day you actually have, keep your habits and work towards your goals.",
  "id": "/planner/",
  "start_url": "/planner/",
  "scope": "/planner/",
  "display": "standalone",
  "background_color": "#f4f5f7",
